{
  "name": "pablo",
  "private": true,
  "version": "0.0.0",
  "description": "Pablo — a multiplayer card game inspired by the Tunisian classic.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests"
  ],
  "scripts": {
    "typecheck": "bun run --filter='*' typecheck",
    "test": "bun test",
    "test:engine": "bun test packages/engine",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test",
    "mobile": "bun --cwd=apps/mobile run start",
    "mobile:ios": "bun --cwd=apps/mobile run ios",
    "mobile:web": "bun --cwd=apps/mobile run web",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:functions": "supabase functions serve",
    "build:engine-bundle": "bun build packages/engine/src/index.ts --format esm --outfile supabase/functions/_shared/engine.bundle.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@supabase/supabase-js": "^2.106.0",
    "@types/bun": "latest",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.21.0"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20"
  }
}
