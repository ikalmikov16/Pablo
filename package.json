{
  "name": "pablo",
  "private": true,
  "version": "0.0.0",
  "description": "Pablo — a multiplayer card game inspired by the Tunisian classic.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter='*' typecheck",
    "test": "bun test",
    "test:engine": "bun test packages/engine",
    "mobile": "bun --cwd apps/mobile run start",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:functions": "supabase functions serve"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/bun": "latest"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20"
  }
}
